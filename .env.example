# Строка подключения к базе. Нужна только при запуске сервера без Docker:
# порт 5433 проброшен из контейнера на компьютер.
# В Docker Compose адрес базы задан в docker-compose.yml, эта строка не используется.
DATABASE_URL=postgres://tictactoe:tictactoe@localhost:5433/tictactoe

# Секреты подписи JWT: по 32 случайных байта в base64, у access и refresh они разные.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
